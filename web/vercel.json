{
  "rewrites": [
    { "source": "/api/dhanu", "destination": "/api/snap?k=dhanu" },
    { "source": "/api/dhshort", "destination": "/api/snap?k=dhshort" },
    { "source": "/api/build", "destination": "/api/snap?k=build" },
    { "source": "/:k(dhanu|dhshort)/:d(clips|stills)/:f", "destination": "/api/media?k=:k&d=:d&f=:f" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Robots-Tag", "value": "noindex" },
    { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
  ] }]
}
