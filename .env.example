# Copy to .env (git-ignored) for local use. On Render/Vercel set these as dashboard env vars instead.
# Which service needs what is in DEPLOY.md.

# --- EngineX (Mac + Render only, NEVER Vercel) ---
BASE_URL=
AUTH_KEY=

# --- Redis (Mac, Render, Vercel) ---
# redis://default:PASSWORD@HOST:PORT   (use rediss:// if your plan has TLS)
REDIS_URL=

# --- Vercel Blob, private store (Mac, Render, Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Web UI only (Vercel) ---
# UI_PASSWORD: a long passphrase. COOKIE_SECRET: run  openssl rand -hex 32
UI_PASSWORD=
COOKIE_SECRET=

# --- Optional, Render worker ---
# DATA_DIR: where the worker keeps working files
# DATA_DIR=/tmp/geo
# CONCURRENCY=4
# PUBLISH_MS=30000
